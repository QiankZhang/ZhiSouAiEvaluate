# Docker 构建上下文过滤（构建上下文为仓库根）。
# 注意：不要忽略 site/frontend/dist —— 单容器镜像要靠它托管前端。
.git
.gitignore
.DS_Store
**/.DS_Store
.claude
.codebuddy

# 根级文档与设计稿，运行时用不到
/*.md

# Python / Node 中间产物
**/__pycache__
**/*.pyc
**/*.pyo
.venv
venv
**/node_modules
.pytest_cache
.ruff_cache

# 部署产物 / 离线依赖 / 发布包
/dist
# make-release.sh 管理的离线 wheels 不进镜像构建上下文；
# 但博文数据集的 wheels-weibo 需要进（Dockerfile 离线安装用）
site/deploy/vendor/wheels

# 运行时数据与密钥（绝不进镜像；数据走 volume 挂载）
site/backend/.env
site/backend/.env.*
site/backend/data
site/backend/reports
**/*.db
**/*.db-wal
**/*.db-shm

# qinglong 运行时产物（源码进镜像，日志/中间产物不进）
qinglong/logs
qinglong/data
qinglong/results
