# 复制为 /data1/zhisou/zhisou.env（不进版本库）。改完重跑 docker-run.sh 生效。
#
# 大模型网关：目标机 10.2.1.44 实测 http://10.37.254.124:8010/v1/quota 返回 200，可直连，
# 因此默认 auto（真实评测）。容器走默认 bridge 网络即可访问该内网地址。
JUDGE_ENGINE=auto
LLM_BASE_URL=http://10.37.254.124:8010/v1
LLM_MODEL=deepseek-v4-flash
JUDGE_CONCURRENCY=4

# 网关为内网自部署，通常无需 API Key；如网关要求再填。
# LLM_API_KEY=

# 网关侧日调用次数上限（仅前端额度提示用，真正限流以网关 429 为准）
# LLM_DAILY_CALL_LIMIT=1000

# 如需临时关掉真实调用（只看模拟打分）：
# JUDGE_ENGINE=simulated
