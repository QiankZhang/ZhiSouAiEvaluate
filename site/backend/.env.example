# 复制为 backend/.env 并按需填写。大模型接口见仓库根 API.md。
# 网关为内网自部署（OpenAI Chat Completions 兼容），默认无需 API Key。
LLM_BASE_URL=http://10.37.254.124:8010/v1
LLM_API_KEY=
LLM_MODEL=deepseek-v4-flash

# 网关侧日调用次数上限（默认 1000 次/天，见 API.md「额度」）
LLM_DAILY_CALL_LIMIT=1000

# 评测引擎：auto（默认，网关模型走真实调用）| simulated（始终模拟）| agent（强制真实）
JUDGE_ENGINE=auto
JUDGE_CONCURRENCY=4
