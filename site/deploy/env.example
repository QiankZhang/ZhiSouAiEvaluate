# 复制到服务器 /opt/zhisou/app/site/backend/.env
# 大模型网关：公网 ECS 通常连不到内网 10.37.254.124。
# 在打通内网（同 VPC / 专线 / VPN）之前，先用模拟引擎，真实评测暂不可用。
JUDGE_ENGINE=simulated

# 打通内网后改回 auto，并按实际填写网关地址：
# JUDGE_ENGINE=auto
# LLM_BASE_URL=http://10.37.254.124:8010/v1
# LLM_API_KEY=
# LLM_MODEL=deepseek-v4-flash
# LLM_DAILY_CALL_LIMIT=1000
# JUDGE_CONCURRENCY=4
