# 复制为 backend/.env 并按需填写。大模型接口见仓库根 API.md。
# 网关为内网自部署（OpenAI Chat Completions 兼容），默认无需 API Key。
LLM_BASE_URL=http://10.37.254.124:8010/v1
LLM_API_KEY=
LLM_MODEL=deepseek-v4-flash

# 网关侧日调用次数上限（默认 1000 次/天，见 API.md「额度」）
LLM_DAILY_CALL_LIMIT=1000

# 评测引擎：auto（默认，网关模型走真实调用）| simulated（始终模拟）| agent（强制真实）
JUDGE_ENGINE=auto
JUDGE_CONCURRENCY=4

# 博文数据集：mid → 原始物料（qinglong 流水线，见 backend/weibo.py）
# qinglong 仓库目录 + 其 Python 解释器（需已装 aiohttp/redis/pandas/tqdm，且能访问新浪内网）
WEIBO_QINGLONG_DIR=/data1/minisearch/upload/qinglong
WEIBO_QINGLONG_PYTHON=python3
WEIBO_QINGLONG_BASE_PATH=
WEIBO_CONVERT_CONCURRENCY=10
WEIBO_CONVERT_TIMEOUT_SEC=3600
WEIBO_MID_MAX=2000
# 置 1 跳过真实转换、用占位物料（无内网联调用）
WEIBO_CONVERT_STUB=
